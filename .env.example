# ==========================================
# JARVIS Voice Agent — Environment Variables
# ==========================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# NEVER commit .env to version control.

# ─── REQUIRED API KEYS ───────────────────────────────────

# 1. LIVEKIT (WebRTC & Room Hosting)
#    Sign up at: https://cloud.livekit.io/
#    Create a new project → Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 2. GOOGLE GEMINI (LLM — Brain)
#    Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. DEEPGRAM (Speech-to-Text)
#    Sign up at: https://console.deepgram.com/
#    Create a new API Key in your project settings.
DEEPGRAM_API_KEY=

# 4. ELEVENLABS (Text-to-Speech)
#    Sign up at: https://elevenlabs.io/
#    Go to Profile → Profile + API key
ELEVENLABS_API_KEY=

# ─── PERSONALISATION (optional) ──────────────────────────

# Your name — JARVIS will address you by name instead of "sir"
# USER_NAME=

# ─── MODEL CONFIGURATION (optional) ─────────────────────

# Gemini model (default: gemini-3-flash-preview)
# GEMINI_MODEL=gemini-3-flash-preview

# ElevenLabs TTS model (default: eleven_flash_v2_5)
# ELEVENLABS_MODEL=eleven_flash_v2_5

# ElevenLabs voice ID (default: lUTamkMw7gOzZbFIwmq4)
#   Browse voices at: https://elevenlabs.io/voice-library
# ELEVENLABS_VOICE_ID=lUTamkMw7gOzZbFIwmq4

# ─── VOICE TUNING (optional) ────────────────────────────

# Speech speed — 0.7 (slow) to 1.3 (fast). Default: 1.14
# ELEVENLABS_SPEED=1.14

# Voice stability — 0.0 (more varied) to 1.0 (more consistent). Default: 0.40
# ELEVENLABS_STABILITY=0.40

# Voice similarity boost — 0.0 to 1.0. Default: 0.75
# ELEVENLABS_SIMILARITY=0.75

# Voice style — 0.0 (neutral) to 1.0 (expressive). Default: 0.0
# ELEVENLABS_STYLE=0.0

# ─── OPENCLAW (Agent System) ────────────────────────────
#
# JARVIS dispatches tasks to OpenClaw for execution.
# Install OpenClaw: npm install -g openclaw@latest
# Setup:           openclaw onboard --install-daemon
# Docs:            https://github.com/marliechorgan/openclaw
#
# By default, JARVIS connects to your local OpenClaw Gateway
# via the `openclaw` CLI. If you don't have OpenClaw installed,
# set USE_OPENCLAW_STUB=true to use a built-in demo simulation.

# Set to "true" ONLY if you don't have OpenClaw installed.
# The stub simulates agent responses using Gemini for demo purposes.
# USE_OPENCLAW_STUB=true

# OpenClaw agent to route directives to (default: main)
# OPENCLAW_AGENT=main

# OpenClaw CLI timeout in seconds (default: 600)
# OPENCLAW_TIMEOUT=600
