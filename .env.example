# ==========================================
# JARVIS Voice Agent — Environment Variables
# ==========================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# NEVER commit .env to version control.

# ─── REQUIRED API KEYS ───────────────────────────────────

# 1. LIVEKIT (WebRTC & Room Hosting)
#    Sign up at: https://cloud.livekit.io/
#    Create a new project → Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 2. GOOGLE GEMINI (LLM — Brain)
#    Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. DEEPGRAM (Speech-to-Text)
#    Sign up at: https://console.deepgram.com/
#    Create a new API Key in your project settings.
DEEPGRAM_API_KEY=

# 4. ELEVENLABS (Text-to-Speech)
#    Sign up at: https://elevenlabs.io/
#    Go to Profile → Profile + API key
ELEVENLABS_API_KEY=

# ─── PERSONALISATION (optional) ──────────────────────────

# Your name — JARVIS will address you by name instead of "sir"
# USER_NAME=

# ─── MODEL CONFIGURATION (optional) ─────────────────────

# Gemini model (default: gemini-3.5-flash — GA successor to gemini-3-flash-preview;
# better tool-calling + GA SLOs that cut the 504/DEADLINE_EXCEEDED errors).
# GEMINI_MODEL=gemini-3.5-flash

# Thinking level for the router LLM: MINIMAL | LOW | MEDIUM | HIGH (gemini-3.x).
# Default LOW — keeps latency low but reasons enough for reliable routing/synthesis.
# GEMINI_THINKING=LOW

# Total output-token budget per turn. Generous so the LLM can write LONG dispatch
# directives (the directive is tool-call output and shares this budget). Spoken
# length is bounded separately by GEMINI_MAX_SPOKEN_CHARS, so this does not
# throttle directives.
# GEMINI_MAX_OUTPUT_TOKENS=1500

# Spoken-monologue backstop: max characters of a single turn sent to TTS
# (~700 ≈ 10-12s). Bounds AUDIO only; directives/tool args are never spoken.
# GEMINI_MAX_SPOKEN_CHARS=700

# ElevenLabs TTS model (default: eleven_flash_v2_5)
# ELEVENLABS_MODEL=eleven_flash_v2_5

# ElevenLabs voice ID (default: lUTamkMw7gOzZbFIwmq4)
#   Browse voices at: https://elevenlabs.io/voice-library
# ELEVENLABS_VOICE_ID=lUTamkMw7gOzZbFIwmq4

# ─── VOICE TUNING (optional) ────────────────────────────

# Speech speed — 0.7 (slow) to 1.3 (fast). Default: 1.14
# ELEVENLABS_SPEED=1.14

# Voice stability — 0.0 (more varied) to 1.0 (more consistent). Default: 0.40
# ELEVENLABS_STABILITY=0.40

# Voice similarity boost — 0.0 to 1.0. Default: 0.75
# ELEVENLABS_SIMILARITY=0.75

# Voice style — 0.0 (neutral) to 1.0 (expressive). Default: 0.0
# ELEVENLABS_STYLE=0.0

# ─── BACKEND: CLAUDE CODE (default doer) ────────────────
#
# By default JARVIS dispatches tasks to a headless Claude Code session
# (src/claude_client.py). It runs at the right working directory so the
# correct CLAUDE.md + memory loads, and resumes a per-target session across
# turns. The voice LLM picks target per task: 'defyner' (cwd ~/Defyner) or
# 'personal' (cwd ~).

# Model for the backend doer (default: claude-sonnet-5 — faster than Opus).
# CLAUDE_MODEL=claude-sonnet-5

# Path to the claude binary (default: "claude" on PATH).
# CLAUDE_BIN=claude

# Backend timeout in seconds (default: 300).
# CLAUDE_TIMEOUT=300

# Permission mode for the headless session (default: bypassPermissions — a voice
# agent has no TTY to approve prompts, so a prompt = a hung turn). The directive
# prefix restricts the session to read/investigate (no sends/pushes/deletes).
# CLAUDE_PERMISSION_MODE=bypassPermissions

# Override target working dirs if yours differ.
# CLAUDE_DEFYNER_DIR=~/Defyner
# CLAUDE_PERSONAL_DIR=~

# ─── OPENCLAW (alternative backend) ─────────────────────
#
# Set USE_OPENCLAW=true to route to the OpenClaw CLI instead of Claude Code.
# Install OpenClaw: npm install -g openclaw@latest
# Setup:           openclaw onboard --install-daemon
# Docs:            https://github.com/marliechorgan/openclaw
# USE_OPENCLAW=true

# Or set USE_OPENCLAW_STUB=true to use a built-in demo simulation.

# Set to "true" ONLY if you don't have OpenClaw installed.
# The stub simulates agent responses using Gemini for demo purposes.
# USE_OPENCLAW_STUB=true

# OpenClaw agent to route directives to (default: main)
# OPENCLAW_AGENT=main

# OpenClaw CLI timeout in seconds (default: 600)
# OPENCLAW_TIMEOUT=600
