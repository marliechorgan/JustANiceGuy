# ==========================================
# JARVIS Voice Agent — Environment Variables
# ==========================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# NEVER commit .env to version control.

# 1. LIVEKIT (WebRTC & Room Hosting)
#    Sign up at: https://cloud.livekit.io/
#    Create a new project → Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 2. GOOGLE GEMINI (LLM — Brain)
#    Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. DEEPGRAM (Speech-to-Text)
#    Sign up at: https://console.deepgram.com/
#    Create a new API Key in your project settings.
DEEPGRAM_API_KEY=

# 4. ELEVENLABS (Text-to-Speech)
#    Sign up at: https://elevenlabs.io/
#    Go to Profile → Profile + API key
ELEVENLABS_API_KEY=

# 5. OPENCLAW (Optional — Agent System)
#    Set to "true" to use the built-in stub instead of a real OpenClaw instance.
#    The stub simulates agent responses using Gemini for demo purposes.
USE_OPENCLAW_STUB=true
